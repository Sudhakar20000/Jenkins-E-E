pipeline {

    agent {
        node {
            label 'Agent-node'
        }
    }

    environment {
        APP_VERSION = ''
        ACC_ID = '129678139522'
        PROJECT = 'flipkart'
        COMPONENT = 'catalogue'
    }

    parameters {
        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy the application'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {

          stages {
                    stage('Read Version') {
                steps {
                    script {
                        def packageJson = readJSON file: 'workspaces/flipkart/pipelines/catalogue/package.json'
                        def appVersion = packageJson.version
                        echo "The version is: ${appVersion}"
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('piplines/catalogue') {
                    sh '''
                        set -e

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."

                        npm install

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Unit tests') {
            steps {
                dir('piplines/catalogue') {
                    sh '''
                        set -e

                        echo "Running unit tests..."

                        npm test

                        echo "Unit tests completed successfully."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('piplines/catalogue') {

                    withSonarQubeEnv('sonar-server') {

                        sh """
                            set -e

                            echo "Starting SonarQube Analysis..."

                            ${tool 'sonar-8'}/bin/sonar-scanner

                            echo "SonarQube analysis completed."
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    script {

                        echo 'Waiting for SonarQube Quality Gate...'

                        def qg = waitForQualityGate()

                        echo "SonarQube Quality Gate Status: ${qg.status}"

                        if (qg.status != 'OK') {
                            error "Pipeline aborted because SonarQube Quality Gate status is: ${qg.status}"
                        }

                        echo "SonarQube Quality Gate passed."
                    }
                }
            }
        }

        stage('Check Dependabot Alerts') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        REPO="daws-90s/catalogue"

                        echo "Checking Dependabot Alerts..."
                        echo "Repository: ${REPO}"

                        curl -sS -L \
                            -H "Accept: application/vnd.github+json" \
                            -H "Authorization: Bearer ${GH_TOKEN}" \
                            -H "X-GitHub-Api-Version: 2026-03-10" \
                            "https://api.github.com/repos/${REPO}/dependabot/alerts?state=open" \
                            -o alerts.json

                        echo "Open Dependabot Alerts:"

                        jq -r '
                            .[] |
                            "\\(.number)\\t\\(.security_vulnerability.severity)\\t\\(.dependency.package.name)\\t\\(.security_advisory.ghsa_id)"
                        ' alerts.json

                        HIGH_CRITICAL_COUNT=$(jq '
                            [
                                .[] |
                                select(
                                    .security_vulnerability.severity == "high"
                                    or
                                    .security_vulnerability.severity == "critical"
                                )
                            ] | length
                        ' alerts.json)

                        echo "High/Critical alert count: ${HIGH_CRITICAL_COUNT}"

                        if [ "${HIGH_CRITICAL_COUNT}" -gt 0 ]; then

                            echo "Found ${HIGH_CRITICAL_COUNT} High/Critical dependency alert(s)."
                            echo "Failing pipeline."

                            exit 1

                        else

                            echo "No High/Critical dependency alerts found."

                        fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {

                script {

                    echo "Building Docker image..."
                    echo "Application: ${env.PROJECT}"
                    echo "Component: ${env.COMPONENT}"
                    echo "Version: ${env.APP_VERSION}"

                    withAWS(credentials: 'aws-creds', region: 'us-east-1') {

                        dir('piplines/catalogue') {
                            // Using triple double-quotes to allow Jenkins to resolve ${ACC_ID}, ${PROJECT}, etc.
                            sh """
                                set -e

                                AWS_REGION="us-east-1"

                                ECR_REGISTRY="${env.ACC_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com"

                                IMAGE="\${ECR_REGISTRY}/${env.PROJECT}/${env.COMPONENT}:${env.APP_VERSION}"

                                echo "ECR Registry: \${ECR_REGISTRY}"
                                echo "Docker Image: \${IMAGE}"

                                echo "Logging in to AWS ECR..."

                                aws ecr get-login-password \
                                    --region "\${AWS_REGION}" |
                                docker login \
                                    --username AWS \
                                    --password-stdin "\textE\${ECR_REGISTRY}"

                                echo "Building Docker image..."

                                docker build \
                                    -t "\${IMAGE}" \
                                    .

                                echo "Docker image built successfully."
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy Scan') {
            steps {

                script {

                    echo "Starting Trivy security scan..."

                    def dockerfileScan

                    dir('piplines/catalogue') {

                        dockerfileScan = sh(
                            script: '''
                                set +e

                                trivy config \
                                    --exit-code 1 \
                                    --severity HIGH,CRITICAL \
                                    --format table \
                                    ./Dockerfile

                                EXIT_CODE=$?

                                echo "Dockerfile Trivy exit code: ${EXIT_CODE}"

                                exit ${EXIT_CODE}
                            ''',
                            returnStatus: true
                        )
                    }

                    echo "Dockerfile scan exit code: ${dockerfileScan}"
                    
                    if (dockerfileScan != 0) {
                        error "Pipeline failed due to Trivy security scan failures."
                    }
                }
            }
        }
    }
}