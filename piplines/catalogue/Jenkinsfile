pipeline {

    agent {
        node {
            label 'Agent-node'
        }
    }

    stages {
        stage('Read Package Info') {
            steps {
                script {
                    // Change context to the folder where the app code lives
                    dir('piplines/catalogue') {
                        def packageJson = readJSON file: 'package.json'
                        def appName = packageJson.name
                        def appVersion = packageJson.version
                        
                        echo "Building ${appName} - Version: ${appVersion}"
                    }
                }
            }
        }
    }
}