pipeline {

    agent {
        node {
            label 'Agent-node'
        }
    }

    environment {
        appVersion = ''
        acc_id = '129678139522'
        project = 'flipkart'
        component = 'catalogue'
    }

    parameters {
        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy the application'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        stage('Read version') {
            steps {
                script {
                    def packageJson = readJSON file: 'package.json'

                    env.appVersion = packageJson.version

                    echo "Application version: ${env.appVersion}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -e
                    npm install
                '''
            }
        }

        stage('Unit tests') {
            steps {
                sh '''
                    set -e
                    npm test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        set -e
                        ${SONAR_SCANNER_HOME}/bin/sonar-scanner
                    '''
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline aborted because SonarQube Quality Gate status is: ${qg.status}"
                        }

                        echo "SonarQube Quality Gate passed: ${qg.status}"
                    }
                }
            }
        }

        stage('Check Dependabot Alerts') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        REPO="daws-90s/catalogue"

                        echo "Checking Dependabot alerts for ${REPO}..."

                        curl -sS -L \
                            -H "Accept: application/vnd.github+json" \
                            -H "Authorization: Bearer ${GH_TOKEN}" \
                            -H "X-GitHub-Api-Version: 2026-03-10" \
                            "https://api.github.com/repos/${REPO}/dependabot/alerts?state=open" \
                            -o alerts.json

                        echo "---- Open Dependabot Alerts ----"

                        jq -r '
                            .[] |
                            "\\(.number)\\t\\(.security_vulnerability.severity)\\t\\(.dependency.package.name)\\t\\(.security_advisory.ghsa_id)"
                        ' alerts.json

                        HIGH_CRITICAL_COUNT=$(jq '
                            [
                                .[] |
                                select(
                                    .security_vulnerability.severity == "high"
                                    or
                                    .security_vulnerability.severity == "critical"
                                )
                            ] | length
                        ' alerts.json)

                        echo "High/Critical alert count: ${HIGH_CRITICAL_COUNT}"

                        if [ "${HIGH_CRITICAL_COUNT}" -gt 0 ]; then
                            echo "Found ${HIGH_CRITICAL_COUNT} High/Critical dependency alert(s)."
                            echo "Failing the build."
                            exit 1
                        else
                            echo "No High/Critical dependency alerts found."
                        fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    echo "Building Docker image..."
                    echo "Image version: ${env.appVersion}"

                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -e

                            AWS_REGION="us-east-1"
                            ECR_REGISTRY="${acc_id}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                            IMAGE="${ECR_REGISTRY}/${project}/${component}:${appVersion}"

                            echo "Logging in to AWS ECR..."

                            aws ecr get-login-password \
                                --region "${AWS_REGION}" |
                            docker login \
                                --username AWS \
                                --password-stdin "${ECR_REGISTRY}"

                            echo "Building image: ${IMAGE}"

                            docker build \
                                -t "${IMAGE}" \
                                .

                            echo "Docker build completed successfully."
                        '''
                    }
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {

                    echo "Scanning Dockerfile with Trivy..."

                    def dockerfileScan = sh(
                        script: '''
                            set +e

                            trivy config \
                                --exit-code 1 \
                                --severity HIGH,CRITICAL \
                                --format table \
                                ./Dockerfile

                            exit $?
                        ''',
                        returnStatus: true
                    )

                    echo "Dockerfile Trivy exit code: ${dockerfileScan}"

                    echo "Scanning Docker image with Trivy..."

                    def imageScan = sh(
                        script: '''
                            set +e

                            trivy image \
                                --scanners vuln \
                                --pkg-types os \
                                --exit-code 1 \
                                --severity HIGH,CRITICAL \
                                --format table \
                                "${acc_id}.dkr.ecr.us-east-1.amazonaws.com/${project}/${component}:${appVersion}"

                            exit $?
                        ''',
                        returnStatus: true
                    )

                    echo "Docker image Trivy exit code: ${imageScan}"

                    if (dockerfileScan != 0 || imageScan != 0) {
                        error '''
Trivy found HIGH/CRITICAL security issues
in the Dockerfile and/or Docker image.
Pipeline failed.
'''
                    }

                    echo "Trivy security scan passed."
                }
            }
        }

        stage('ECR Image Push') {
            steps {
                script {

                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -e

                            AWS_REGION="us-east-1"
                            ECR_REGISTRY="${acc_id}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                            IMAGE="${ECR_REGISTRY}/${project}/${component}:${appVersion}"

                            echo "Logging in to AWS ECR..."

                            aws ecr get-login-password \
                                --region "${AWS_REGION}" |
                            docker login \
                                --username AWS \
                                --password-stdin "${ECR_REGISTRY}"

                            echo "Pushing image: ${IMAGE}"

                            docker push "${IMAGE}"

                            echo "Docker image pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    params.DEPLOY
                }
            }

            steps {
                script {
                    echo "Deploying ${project}/${component}:${env.appVersion}"

                    sh '''
                        set -e

                        echo "Deploying application..."
                        echo "Application: ${project}"
                        echo "Component: ${component}"
                        echo "Version: ${appVersion}"

                        # Add your actual deployment commands here.
                        echo "Deployment completed."
                    '''
                }
            }
        }
    }

    post {

        always {
            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}