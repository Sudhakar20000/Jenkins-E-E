pipeline {

    agent {
        node {
            label 'Agent-node'
        }
    }

    environment {
        appVersion = ''
        acc_id = '129678139522'
        project = 'flipkart'
        component = 'catalogue'
    }

    parameters {
        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy the application'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        stage('Read version') {
            steps {
                dir('piplines/catalogue') {
                    script {
                        echo 'Reading application version...'

                        sh '''
                            set -e

                            echo "Current directory:"
                            pwd

                            echo "Files:"
                            ls -la

                            if [ ! -f package.json ]; then
                                echo "ERROR: package.json not found"
                                exit 1
                            fi

                            echo "package.json found"
                        '''

                        env.appVersion = sh(
                            script: 'node -p "require(\'./package.json\').version"',
                            returnStdout: true
                        ).trim()

                        echo "Application version: ${env.appVersion}"
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('piplines/catalogue') {
                    sh '''
                        set -e

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."

                        npm install

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Unit tests') {
            steps {
                dir('piplines/catalogue') {
                    sh '''
                        set -e

                        echo "Running unit tests..."

                        npm test

                        echo "Unit tests completed successfully."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('piplines/catalogue') {
                    withSonarQubeEnv('sonar-server') {
                        sh """
                            set -e

                            echo "Starting SonarQube analysis..."

                            ${tool 'sonar-8'}/bin/sonar-scanner

                            echo "SonarQube analysis completed."
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {

                        echo 'Waiting for SonarQube Quality Gate...'

                        def qg = waitForQualityGate()

                        echo "SonarQube Quality Gate status: ${qg.status}"

                        if (qg.status != 'OK') {
                            error "Pipeline aborted: SonarQube Quality Gate status is ${qg.status}"
                        }

                        echo 'SonarQube Quality Gate passed.'
                    }
                }
            }
        }

        stage('Check Dependabot Alerts') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        REPO="daws-90s/catalogue"

                        echo "Checking Dependabot alerts..."
                        echo "Repository: ${REPO}"

                        curl -sS -L \
                            -H "Accept: application/vnd.github+json" \
                            -H "Authorization: Bearer ${GH_TOKEN}" \
                            -H "X-GitHub-Api-Version: 2026-03-10" \
                            "https://api.github.com/repos/${REPO}/dependabot/alerts?state=open" \
                            -o alerts.json

                        echo "---- Open Dependabot Alerts ----"

                        jq -r '
                            .[] |
                            "\\(.number)\\t\\(.security_vulnerability.severity)\\t\\(.dependency.package.name)\\t\\(.security_advisory.ghsa_id)"
                        ' alerts.json

                        HIGH_CRITICAL_COUNT=$(jq '
                            [
                                .[] |
                                select(
                                    .security_vulnerability.severity == "high"
                                    or
                                    .security_vulnerability.severity == "critical"
                                )
                            ] | length
                        ' alerts.json)

                        echo "High/Critical alert count: ${HIGH_CRITICAL_COUNT}"

                        if [ "${HIGH_CRITICAL_COUNT}" -gt 0 ]; then
                            echo "Found ${HIGH_CRITICAL_COUNT} High/Critical dependency alert(s)."
                            echo "Failing pipeline."
                            exit 1
                        else
                            echo "No High/Critical dependency alerts found."
                        fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {

                    echo "Building Docker image..."
                    echo "Application version: ${env.appVersion}"

                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {

                        dir('piplines/catalogue') {

                            sh '''
                                set -e

                                AWS_REGION="us-east-1"
                                ECR_REGISTRY="${acc_id}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                                IMAGE="${ECR_REGISTRY}/${project}/${component}:${appVersion}"

                                echo "Logging in to AWS ECR..."

                                aws ecr get-login-password \
                                    --region "${AWS_REGION}" |
                                docker login \
                                    --username AWS \
                                    --password-stdin "${ECR_REGISTRY}"

                                echo "Building Docker image:"
                                echo "${IMAGE}"

                                docker build \
                                    -t "${IMAGE}" \
                                    .

                                echo "Docker image built successfully."
                            '''
                        }
                    }
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {

                    echo 'Starting Trivy Dockerfile scan...'

                    def dockerfileScan

                    dir('piplines/catalogue') {

                        dockerfileScan = sh(
                            script: '''
                                set +e

                                trivy config \
                                    --exit-code 1 \
                                    --severity HIGH,CRITICAL \
                                    --format table \
                                    ./Dockerfile

                                exit $?
                            ''',
                            returnStatus: true
                        )
                    }

                    echo "Dockerfile scan exit code: ${dockerfileScan}"

                    echo 'Starting Trivy image scan...'

                    def imageScan = sh(
                        script: """
                            set +e

                            trivy image \
                                --scanners vuln \
                                --pkg-types os \
                                --exit-code 1 \
                                --severity HIGH,CRITICAL \
                                --format table \
                                "${acc_id}.dkr.ecr.us-east-1.amazonaws.com/${project}/${component}:${appVersion}"

                            exit \$?
                        """,
                        returnStatus: true
                    )

                    echo "Docker image scan exit code: ${imageScan}"

                    if (dockerfileScan != 0 || imageScan != 0) {
                        error '''
Trivy found HIGH/CRITICAL security vulnerabilities.
Pipeline failed.
'''
                    }

                    echo 'Trivy security scans passed.'
                }
            }
        }

        stage('ECR Image Push') {
            steps {
                script {

                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {

                        sh '''
                            set -e

                            AWS_REGION="us-east-1"
                            ECR_REGISTRY="${acc_id}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                            IMAGE="${ECR_REGISTRY}/${project}/${component}:${appVersion}"

                            echo "Logging in to AWS ECR..."

                            aws ecr get-login-password \
                                --region "${AWS_REGION}" |
                            docker login \
                                --username AWS \
                                --password-stdin "${ECR_REGISTRY}"

                            echo "Pushing Docker image:"
                            echo "${IMAGE}"

                            docker push "${IMAGE}"

                            echo "Docker image pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    params.DEPLOY
                }
            }

            steps {
                script {

                    echo "Starting deployment..."

                    sh '''
                        set -e

                        echo "Deploying application..."
                        echo "Project    : ${project}"
                        echo "Component  : ${component}"
                        echo "Version    : ${appVersion}"

                        # Add your actual deployment command here.

                        echo "Deployment completed successfully."
                    '''
                }
            }
        }
    }

    post {

        always {
            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}